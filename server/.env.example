# ตัวอย่างค่า ห้ามใส่รหัสผ่านจริงลง git
DATABASE_URL=postgres://hemo:hemo@localhost:5432/hemo_sync
PORT=3000
# อ่านค่าจากภาพหน้าจอเครื่องฟอก (ส่งภาพไป Anthropic API) เปิดเมื่อโรงพยาบาลอนุมัติแล้วเท่านั้น
# SCREEN_READER=claude
# ANTHROPIC_API_KEY=
# ส่ง SMS เตือนค่าผิดปกติระหว่างฟอก: ระบบ POST JSON { "to": "0812345678", "message": "..." } ไปที่ URL นี้
# ใช้ API ของผู้ให้บริการ SMS ที่โรงพยาบาลทำสัญญาไว้ หรือบริการตัวกลางของฝ่าย IT ถ้าไม่ตั้ง จะบันทึกว่ายังไม่ได้ส่ง
# SMS_WEBHOOK_URL=
# SMS_WEBHOOK_TOKEN=
